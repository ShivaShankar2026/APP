{% load static %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>YTKSA — Detection Results</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700;900&display=swap" rel="stylesheet">
<style>
  :root{
    --yt-red:#FF0000;
    --yt-dark:#0F0F0F;
    --yt-gray:#606060;
    --yt-light-gray:#F1F1F1;
    --safe-green:#0B8043;
    --flag-red:#D93025;
  }
  body{font-family:'Roboto',sans-serif;background:#fff;color:var(--yt-dark);}

  .yt-navbar{
    display:flex;align-items:center;justify-content:space-between;
    padding:10px 24px;border-bottom:1px solid #e5e5e5;
  }
  .yt-logo{display:flex;align-items:center;gap:6px;font-weight:700;font-size:20px;}
  .yt-logo .play-icon{
    width:30px;height:21px;background:var(--yt-red);border-radius:6px;
    display:flex;align-items:center;justify-content:center;
  }
  .yt-logo .play-icon::after{
    content:"";width:0;height:0;
    border-top:5px solid transparent;border-bottom:5px solid transparent;
    border-left:8px solid #fff;margin-left:2px;
  }
  .yt-search{max-width:600px;flex:1;margin:0 40px;}
  .yt-search input{border-radius:20px 0 0 20px;border:1px solid #ccc;padding:8px 16px;}
  .yt-search button{
    border-radius:0 20px 20px 0;background:var(--yt-light-gray);
    border:1px solid #ccc;border-left:none;padding:8px 20px;
  }

  .page-layout{
    max-width:1400px;margin:24px auto;padding:0 16px;
    display:grid;grid-template-columns:1fr;gap:24px;
  }
  @media(min-width:1100px){
    .page-layout{grid-template-columns:minmax(0,900px) 1fr;align-items:start;}
  }

  .video-embed{border-radius:12px;overflow:hidden;background:#000;}
  .video-embed iframe{width:100%;aspect-ratio:16/9;border:0;}
  .video-title{font-size:20px;font-weight:700;margin-top:14px;}

  .sentiment-badge{
    display:inline-flex;align-items:center;gap:6px;
    padding:6px 14px;border-radius:20px;font-weight:700;font-size:13px;margin-top:8px;
  }
  .sentiment-verypositive{background:#E6F4EA;color:var(--safe-green);}
  .sentiment-positive{background:#E6F4EA;color:#188038;}
  .sentiment-neutral{background:#F1F1F1;color:var(--yt-gray);}
  .sentiment-negative{background:#FCE8E6;color:#C5221F;}
  .sentiment-verynegative{background:#FCE8E6;color:var(--flag-red);}

  .comments-header{
    font-weight:700;font-size:16px;margin:32px 0 16px;
    display:flex;align-items:center;gap:8px;
  }
  .comment-row{display:flex;gap:12px;margin-bottom:20px;}
  .comment-avatar{
    width:40px;height:40px;border-radius:50%;flex-shrink:0;
    background:linear-gradient(135deg,#606060,#0F0F0F);
    display:flex;align-items:center;justify-content:center;
    color:#fff;font-weight:700;font-size:15px;
  }
  .comment-body{flex:1;}
  .comment-author{font-weight:500;font-size:13px;margin-right:8px;}
  .comment-text{font-size:14px;color:#0F0F0F;line-height:1.4;}
  .comment-meta{display:flex;align-items:center;gap:10px;margin-top:6px;}
  .tag{
    font-size:11px;font-weight:700;padding:3px 9px;border-radius:12px;
    display:inline-flex;align-items:center;gap:4px;
  }
  .tag-safe{background:#E6F4EA;color:var(--safe-green);}
  .tag-flagged{background:#FCE8E6;color:var(--flag-red);}

  .comment-flagged .comment-text{filter:blur(4px);user-select:none;pointer-events:none;}
  .flagged-notice{font-size:12px;color:var(--flag-red);font-weight:500;margin-top:4px;}

  .related-header{font-weight:700;font-size:15px;margin-bottom:12px;}
  .related-item{
    display:flex;gap:8px;margin-bottom:10px;cursor:pointer;
    border-radius:10px;padding:6px;transition:background .15s;
    text-decoration:none;color:inherit;
  }
  .related-item:hover{background:var(--yt-light-gray);}
  .related-thumb{
    width:168px;aspect-ratio:16/9;border-radius:8px;object-fit:cover;
    flex-shrink:0;background:#ddd;
  }
  .related-info{min-width:0;}
  .related-title{
    font-size:13px;font-weight:500;line-height:1.3;
    display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
  }
  .related-meta{font-size:12px;color:var(--yt-gray);margin-top:4px;}
  .related-safety{
    display:inline-flex;align-items:center;gap:3px;font-size:11px;font-weight:700;margin-top:4px;
  }
  .related-safety.safe{color:var(--safe-green);}
  .related-safety.caution{color:#B26A00;}
</style>
</head>
<body>

<nav class="yt-navbar">
  <div class="yt-logo"><span class="play-icon"></span> YTKSA</div>
  <form method="POST" class="d-flex yt-search">
    {% csrf_token %}
    <input type="text" name="search" class="form-control" placeholder="Paste a YouTube URL...">
    <button type="submit" class="btn">🔍</button>
  </form>
  <div>
    <a href="{% url 'user_profile' %}" class="btn btn-outline-dark rounded-pill btn-sm me-2">Profile</a>
    <a href="{% url 'user_feedback' %}" class="btn btn-outline-dark rounded-pill btn-sm">Feedback</a>
  </div>
</nav>

<div class="page-layout">

  <div>
    {% if vid %}
      <div class="video-embed">
        <iframe src="https://www.youtube.com/embed/{{ vid }}" title="video" allowfullscreen></iframe>
      </div>
      <div class="video-title">Detection Results</div>

      {% if senti %}
        <span class="sentiment-badge sentiment-{{ senti|slugify }}">
          Overall video sentiment: {{ senti|title }}
        </span>
      {% endif %}

      <div class="comments-header">
        💬 Comments {% if comm %}({{ comm|length }}){% endif %}
      </div>

      {% for c in comm %}
        <div class="comment-row {% if c.child_safe == False %}comment-flagged{% endif %}">
          <div class="comment-avatar">{{ c.name|slice:":1"|upper }}</div>
          <div class="comment-body">
            <span class="comment-author">{{ c.name }}</span>
            <div class="comment-text">{{ c.comment }}</div>
            <div class="comment-meta">
              <span class="tag {% if c.child_safe == False %}tag-flagged{% else %}tag-safe{% endif %}">
                {% if c.child_safe == False %}⚠ Flagged{% else %}✓ Kid-safe{% endif %}
              </span>
              <span class="tag" style="background:#F1F1F1;color:#606060;">{{ c.sentiment }}</span>
            </div>
            {% if c.child_safe == False %}
              <div class="flagged-notice">Hidden from view — matched: {{ c.flag_reason|join:", " }}</div>
            {% endif %}
          </div>
        </div>
      {% empty %}
        <p class="text-muted">No comments found for this video.</p>
      {% endfor %}

    {% else %}
      <div class="text-center text-muted py-5">
        <h5>Paste a YouTube link above to check its comments</h5>
        <p>We'll scan sentiment and flag anything unsafe for children.</p>
      </div>
    {% endif %}
  </div>

  {% if related_videos %}
  <div>
    <div class="related-header">Related videos</div>
    {% for rv in related_videos %}
      <a href="/user-index?vid={{ rv.id }}" class="related-item">
        <img class="related-thumb" src="{{ rv.thumbnail }}" alt="{{ rv.title }}">
        <div class="related-info">
          <div class="related-title">{{ rv.title }}</div>
          <div class="related-meta">{{ rv.channel }}</div>
          {% if rv.child_safe %}
            <div class="related-safety safe">✓ Kid-safe channel history</div>
          {% else %}
            <div class="related-safety caution">⚠ Review before viewing</div>
          {% endif %}
        </div>
      </a>
    {% endfor %}
  </div>
  {% endif %}

</div>

</body>
</html>
# Add this INSIDE your existing user_index() view, right after you fetch
# `results = req.json()['items']` from the search API call — the same
# response already contains multiple videos, not just the first one.
#
# This replaces the need for a separate "related videos" API call
# (YouTube deprecated relatedToVideoId in 2023), and costs zero extra quota.

related_videos = []
for item in results[1:6]:  # skip the first (already the main video), take next 5
    try:
        related_videos.append({
            'id': item['id']['videoId'],
            'title': item['snippet']['title'],
            'channel': item['snippet']['channelTitle'],
            'thumbnail': item['snippet']['thumbnails']['medium']['url'],
            # Reuse your existing child-safety filter on the video title
            # as a quick heuristic before the user even clicks into it.
            'child_safe': check_child_safety(item['snippet']['title'])['is_safe'],
        })
    except (KeyError, IndexError):
        continue

